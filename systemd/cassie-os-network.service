[Unit]
Description=CASSIE selected-device hotspot activity collector
After=NetworkManager.service cassie-os.service
Wants=NetworkManager.service

[Service]
User=cassie-os
Group=cassie-os
StateDirectory=cassie-os
StateDirectoryMode=0700
WorkingDirectory=/opt/cassie-os/app
Environment=CASSIE_STATE_DIR=/var/lib/cassie-os
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/cassie-os/app/network_activity.py
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_PACKET AF_UNIX
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
Nice=10
CPUQuota=20%
MemoryMax=128M
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
