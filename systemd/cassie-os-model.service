[Unit]
Description=CASSIE OS local inference
After=network.target

[Service]
User=cassie-model
Group=cassie-model
StateDirectory=cassie-model
StateDirectoryMode=0700
WorkingDirectory=/var/lib/cassie-model
Environment=HOME=/var/lib/cassie-model
Environment=OLLAMA_MODELS=/var/lib/cassie-model/models
Environment=OLLAMA_HOST=127.0.0.1:11438
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
ExecStart=/opt/cassie-os/ollama-0.40.4/bin/ollama serve
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
