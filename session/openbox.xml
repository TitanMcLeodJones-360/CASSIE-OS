<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktops><number>1</number></desktops>
  <keyboard>
    <keybind key="C-A-space">
      <action name="Execute"><command>/usr/bin/python3 /opt/cassie-os/desktop/session.py --controls</command></action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute"><command>/usr/bin/xterm</command></action>
    </keybind>
    <keybind key="C-A-b">
      <action name="Execute"><command>/usr/bin/blueman-manager</command></action>
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow"><dialog>yes</dialog></action>
    </keybind>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
</openbox_config>
